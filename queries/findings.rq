# Verified SPARQL queries: each re-derives one finding from the graph.
# Run against graph/*.ttl. Prefixes:
# PREFIX biodiv: <https://gov.tesseract.academy/def/biodiversity#>
# PREFIX scheme: <https://gov.tesseract.academy/def/biodiversity/scheme#>

# Q1. Non-conformant identifier assertions per scheme, with reasons.
# (graph/identifiers.ttl)
PREFIX biodiv: <https://gov.tesseract.academy/def/biodiversity#>
SELECT ?scheme ?reason (COUNT(?a) AS ?n) WHERE {
  ?a a biodiv:IdentifierAssertion ;
     biodiv:usesScheme ?scheme ;
     biodiv:schemeConformant false ;
     biodiv:nonConformanceReason ?reason .
} GROUP BY ?scheme ?reason ORDER BY DESC(?n)

# Q2. Identifiers asserted for more than one resource.
